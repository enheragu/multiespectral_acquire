

<launch>
  <!-- GUI configuration -->
  <arg name="gui_title" default="Fisheye Camera GUI" />
  
  <!-- Camera configuration parameters -->
  <arg name="camera1_topic" default="/Fisheye/frontal_camera/image_with_metadata_sync" />
  <arg name="camera1_name" default="Frontal Camera" />
  
  <arg name="camera2_topic" default="/Fisheye/rear_camera/image_with_metadata_sync" />
  <arg name="camera2_name" default="Rear Camera" />
  
  <!-- LIDAR configuration -->
  <arg name="lidar_topic" default="/Fisheye/ouster/reflec_image_sync" />
  <arg name="lidar_name" default="LIDAR Image" />
  
  <group ns="Fisheye">
    <node pkg="multiespectral_acquire_gui" type="multiespectral_control.py" name="fisheye_acquire_gui" output="screen">
      <param name="gui_title" value="$(arg gui_title)" />
      <param name="camera1_topic" value="$(arg camera1_topic)" />
      <param name="camera1_name" value="$(arg camera1_name)" />
      <param name="camera2_topic" value="$(arg camera2_topic)" />
      <param name="camera2_name" value="$(arg camera2_name)" />
      <param name="lidar_topic" value="$(arg lidar_topic)" />
      <param name="lidar_name" value="$(arg lidar_name)" />
    </node>
  </group>
</launch>
