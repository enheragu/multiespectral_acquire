<launch>
  <!-- GUI configuration -->
  <arg name="gui_title" default="Multiespectral Camera GUI" />
  
  <!-- Flask server configuration -->
  <arg name="flask_host" default="0.0.0.0" />
  <arg name="flask_port" default="5051" />
  
  <!-- Camera configuration parameters -->
  <arg name="camera1_topic" default="/Multiespectral/lwir_camera/image_with_metadata_sync" />
  <arg name="camera1_name" default="LWIR Camera" />
  
  <arg name="camera2_topic" default="/Multiespectral/visible_camera/image_with_metadata_sync" />
  <arg name="camera2_name" default="Visible Camera" />
  
  <!-- LIDAR configuration -->
  <arg name="lidar_topic" default="/Multiespectral/ouster/reflec_image_cropped_sync" />
  <arg name="lidar_name" default="LIDAR Image" />
  
  <group ns="Multiespectral">
    <node pkg="multiespectral_acquire_gui" type="multiespectral_control.py" name="multiespectral_acquire_gui" output="screen">
      <!-- Flask server configuration -->
      <param name="flask_host" value="$(arg flask_host)" />
      <param name="flask_port" value="$(arg flask_port)" />
      
      <param name="gui_title" value="$(arg gui_title)" />
      <param name="camera1_topic" value="$(arg camera1_topic)" />
      <param name="camera1_name" value="$(arg camera1_name)" />
      <param name="camera2_topic" value="$(arg camera2_topic)" />
      <param name="camera2_name" value="$(arg camera2_name)" />
      <param name="lidar_topic" value="$(arg lidar_topic)" />
      <param name="lidar_name" value="$(arg lidar_name)" />
      
      <!-- LIDAR topic options for dropdown selector -->
      <!-- Format: list of dicts with 'topic' and 'label' keys -->
      <rosparam param="lidar_topic_options">
        - {topic: '/Multiespectral/ouster/range_image_cropped_sync', label: 'Range Image'}
        - {topic: '/Multiespectral/ouster/reflec_image_cropped_sync', label: 'Reflectivity Image'}
        - {topic: '/Multiespectral/ouster/signal_image_cropped_sync', label: 'Signal Image'}
        - {topic: '/Multiespectral/ouster/nearir_image_cropped_sync', label: 'Near-IR Image'}
      </rosparam>
    </node>
  </group>
</launch>
