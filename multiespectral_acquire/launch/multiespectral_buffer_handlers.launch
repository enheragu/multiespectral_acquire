<launch>
  <!-- Arguments passed from parent launch -->
  <arg name="output_path"/>
  <arg name="main_topic"/>
  <arg name="ouster_exposure_ns"/>  <!-- Still needed for Ouster (not ImageWithMetadata) -->
  
  <!-- Additional topics -->
  <arg name="gnss_topic" default="/gnss/fix"/>
  <arg name="odom_topic" default="/odometry/combined"/>

  <arg name="max_time_diff_ouster" value="0.3"/>
  
  <!-- NOTE: For ImageWithMetadata messages, exposure_time is auto-detected from msg.metadata.exposure_time -->
  <!-- The exposure_time_ns parameter is only needed for non-ImageWithMetadata messages (e.g., Ouster) -->

  <!-- ========================================================================== -->
  <!-- CAMERAS (direct store) -->
  <!-- ========================================================================== -->

  <!-- Visible camera buffer (no main topic = auto store_all) -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_visible" output="screen">
    <param name="handler_type" value="image"/>
    <param name="data_topic" value="visible_camera/image_with_metadata"/>
    <param name="output_path" value="$(arg output_path)/visible"/>
  </node>

  <!-- LWIR camera buffer (synced with visible as main reference) -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_lwir" output="screen">
    <param name="handler_type" value="image"/>
    <param name="data_topic" value="lwir_camera/image_with_metadata"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/lwir"/>
    <param name="max_time_diff" value="0.1"/>
    <!-- exposure_time auto-detected from message metadata -->
  </node>

  <!-- ========================================================================== -->
  <!-- LIDAR: Sync-only buffers (raw -> _sync, no disk) -->
  <!-- These synchronize raw LIDAR data with main reference, output goes to crop nodes -->
  <!-- ========================================================================== -->

  <!-- LIDAR Range Image: sync only -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_range_sync" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="/ouster/range_image"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/lidar_range"/>
    <param name="max_time_diff" value="$(arg max_time_diff_ouster)"/>
    <param name="exposure_time_ns" value="$(arg ouster_exposure_ns)"/>
    <param name="store_data" value="false"/>
    <remap from="/ouster/range_image_sync" to="ouster/range_image_sync"/>
  </node>

  <!-- LIDAR Reflectivity Image: sync only -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_reflec_sync" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="/ouster/reflec_image"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/lidar_reflec"/>
    <param name="max_time_diff" value="$(arg max_time_diff_ouster)"/>
    <param name="exposure_time_ns" value="$(arg ouster_exposure_ns)"/>
    <param name="store_data" value="false"/>
    <remap from="/ouster/reflec_image_sync" to="ouster/reflec_image_sync"/>
  </node>

  <!-- LIDAR Signal Image: sync only -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_signal_sync" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="/ouster/signal_image"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/lidar_signal"/>
    <param name="max_time_diff" value="$(arg max_time_diff_ouster)"/>
    <param name="exposure_time_ns" value="$(arg ouster_exposure_ns)"/>
    <param name="store_data" value="false"/>
    <remap from="/ouster/signal_image_sync" to="ouster/signal_image_sync"/>
  </node>

  <!-- LIDAR Near-IR Image: sync only -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_nearir_sync" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="/ouster/nearir_image"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/lidar_nearir"/>
    <param name="max_time_diff" value="$(arg max_time_diff_ouster)"/>
    <param name="exposure_time_ns" value="$(arg ouster_exposure_ns)"/>
    <param name="store_data" value="false"/>
    <remap from="/ouster/nearir_image_sync" to="ouster/nearir_image_sync"/>
  </node>

  <!-- PointCloud: sync only -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_pointcloud_sync" output="screen">
    <param name="handler_type" value="pointcloud"/>
    <param name="data_topic" value="/ouster/points"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/lidar_pointcloud"/>
    <param name="max_time_diff" value="$(arg max_time_diff_ouster)"/>
    <param name="exposure_time_ns" value="$(arg ouster_exposure_ns)"/>
    <param name="store_data" value="false"/>
    <remap from="/ouster/points_sync" to="ouster/points_sync"/>
  </node>

  <!-- ========================================================================== -->
  <!-- LIDAR: Store buffers (cropped -> disk) -->
  <!-- These receive cropped data from crop nodes and store to disk -->
  <!-- No main_topic = auto store_all mode -->
  <!-- img_name is extracted from frame_id (set by buffer_sync, preserved by crop) -->
  <!-- ========================================================================== -->

  <!-- LIDAR Range Image cropped: store -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_range_store" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="ouster/range_image_sync_cropped"/>
    <param name="output_path" value="$(arg output_path)/lidar_range"/>
  </node>

  <!-- LIDAR Reflectivity Image cropped: store -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_reflec_store" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="ouster/reflec_image_sync_cropped"/>
    <param name="output_path" value="$(arg output_path)/lidar_reflec"/>
  </node>

  <!-- LIDAR Signal Image cropped: store -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_signal_store" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="ouster/signal_image_sync_cropped"/>
    <param name="output_path" value="$(arg output_path)/lidar_signal"/>
  </node>

  <!-- LIDAR Near-IR Image cropped: store -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_nearir_store" output="screen">
    <param name="handler_type" value="simple_image"/>
    <param name="data_topic" value="ouster/nearir_image_sync_cropped"/>
    <param name="output_path" value="$(arg output_path)/lidar_nearir"/>
  </node>

  <!-- PointCloud cropped: store -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_pointcloud_store" output="screen">
    <param name="handler_type" value="pointcloud"/>
    <param name="data_topic" value="ouster/points_sync_cropped"/>
    <param name="output_path" value="$(arg output_path)/lidar_pointcloud"/>
  </node>

  <!-- ========================================================================== -->
  <!-- OTHER SENSORS (synced with main reference) -->
  <!-- ========================================================================== -->

  <!-- GNSS buffer (synced with visible) -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_gnss" output="screen">
    <param name="data_topic" value="$(arg gnss_topic)"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/gnss"/>
    <param name="max_time_diff" value="1.5"/>
  </node>

  <!-- Odometry buffer (synced with visible) -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_odom" output="screen">
    <param name="data_topic" value="$(arg odom_topic)"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/odom"/>
    <param name="max_time_diff" value="1.5"/>
  </node>

  <!-- DHT22 buffer (synced with visible) -->
  <node pkg="multiespectral_acquire" type="buffer_handler_node.py" name="buffer_dht22" output="screen">
    <param name="data_topic" value="/dht22/data"/>
    <param name="main_topic" value="$(arg main_topic)"/>
    <param name="output_path" value="$(arg output_path)/dht22"/>
    <param name="max_time_diff" value="1.5"/>
  </node>

</launch>
