<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multiespectral_acquire</name>
  <version>0.0.0</version>
  <description>Package with FLIR-Basler drivers integrated into ROS2 to handle a multiespectral camera taking images from both cameras in a synchronized way.</description>
  <maintainer email="enrique.he.ag@gmail.com">quique</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- Launch files read hitos_setup's Fast DDS SHM profile (config/fastdds_shm_profile.xml) -->
  <exec_depend>hitos_setup</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
